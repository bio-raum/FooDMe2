params {
    
    database = "co1" 
    fasta = "${baseDir}/assets/primers/COI_guenther.fasta"

    disable_low_complexity = false
    blast_low_complexity = "-dust no -soft_masking false"
    blast_evalue = "1e-20"
    blast_qcov = 100
    blast_perc_id = 97
    blast_bitscore_diff = 4
    blast_min_consensus = 0.51

    taxid_filter = 32443 // teleost fish

    non_overlapping = false

    vsearch = false

    remove_chimera = true

    // Mean: 312.79, StdDev: 1.95, min: 214, max: 340
    amplicon_min_length = 310
    amplicon_max_length = 315
    
    max_expected_errors = 15.6 // err 0.05
    max_ns = 0
    merging_max_mismatch = 1

    pacbio = false
    iontorrent = true
    ont = false

    fastp_options = "--cut_tail --cut_tail_window_size 15 --cut_tail_mean_quality 15 --disable_adapter_trimming --trim_poly_g --poly_g_min_len 10"

    cutadapt_trim_3p        = false
    cutadapt_trim_flex      = true
    cutadapt_options        = "-m 40"

} 