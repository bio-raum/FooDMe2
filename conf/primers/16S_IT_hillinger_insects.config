params {

    database = "lrna"
    fasta = "${baseDir}/assets/primers/16S_hillinger.fasta"

    disable_low_complexity = true
    blast_low_complexity = "-dust no -soft_masking false"
    blast_evalue = "1e-20"
    blast_qcov = 99
    blast_perc_id = 97
    blast_bitscore_diff = 4
    blast_min_consensus = 0.51 

    non_overlapping = false

    vsearch = false

    taxid_filter = 50557 // insecta

    remove_chimera = true
    max_ns = 0
    merging_max_mismatch = 1

    max_expected_errors = 10.0 // err: 0.05

    // Mean: 177.9, StdDev: 24.55, min: 128.81, max: 226.99
    amplicon_min_length = 140
    amplicon_max_length = 192
    
    pacbio = false
    iontorrent = true
    ont = false

    // we cut the torrent tail based on quality, and then cut the remaining fragment to the maximum length of amplicon expected (assuming it wasnt cut shorter)
    // Note: length filtering is configured in the trimming.config file
    fastp_options = "--cut_tail --cut_tail_window_size 15 --cut_tail_mean_quality 15 --disable_adapter_trimming --trim_poly_g --poly_g_min_len 10"

    cutadapt_trim_3p        = true
    cutadapt_trim_flex      = false
    cutadapt_options        = "-m 40"

} 